<Window x:Class="F1.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="F1 Help" Width="720" SizeToContent="Height" MinHeight="220" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" Background="#171B23" Foreground="#F0F3F8" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Border Padding="20" BorderBrush="#465367" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
        <TextBlock Text="F1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Close · Esc" Click="CloseClicked" AutomationProperties.Name="Close help"/>
        <ComboBox x:Name="Profile" Width="125" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="ProfileChanged" AutomationProperties.Name="Agent profile"><ComboBoxItem Content="Help"/><ComboBoxItem Content="Session"/></ComboBox>
      </DockPanel>
      <TextBlock Grid.Row="1" x:Name="ContextLabel" Foreground="#BCC8D9" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox Grid.Row="2" x:Name="Question" FontSize="18" MinHeight="48" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#242C39" Foreground="White" CaretBrush="White" AutomationProperties.Name="Question"/>
      <TextBlock Grid.Row="3" x:Name="Status" Text="Ready" Foreground="#BCC8D9" TextWrapping="Wrap" Margin="0,4,0,12" AutomationProperties.LiveSetting="Polite"/>
      <ScrollViewer Grid.Row="4" x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto" MaxHeight="420"><TextBox x:Name="Answer" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#F0F3F8" FontSize="16" TextWrapping="Wrap" AutomationProperties.Name="Answer"/></ScrollViewer>
      <TextBlock Grid.Row="5" Text="Enter to ask · Shift+Enter for a new line · Ctrl+L to clear" Foreground="#BCC8D9" Margin="0,12,0,0"/>
    </Grid>
  </Border>
</Window>
